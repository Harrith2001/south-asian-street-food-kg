            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#potatoes%20(chopped)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#red%20chili%20powder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#tamarind%20paste"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#turmeric%20(powdered)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Boil toor dal until soft. In oil/ghee heat mustard seeds, cumin seeds, fenugreek, curry leaves, chana dal until seeds pop. 
Add chopped vegetables, turmeric, red chili powder, salt. Sauté 3 minutes.
Add boiled dal, 2 cups water, tamarind paste. Simmer 20 minutes until vegetables tender. 
Finish with roasted coriander-cumin powder, asafoetida.</instructions>
        <rdfs:label>Sambar</rdfs:label>
    </owl:Class>
    


