    <!-- http://example.org/southasianstreetfood#MasalaDosa -->

    <owl:NamedIndividual rdf:about="http://example.org/southasianstreetfood#MasalaDosa"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://example.org/southasianstreetfood#MasalaDosa">
        <instructions>Heat griddle. Pour thin layer of dosa batter. Spread evenly. Cook until crispy. Add spiced potato filling. Fold in half.</instructions>
        <rdfs:comment>A masala dosa is a popular South Indian dish consisting of a thin, crispy, and slightly tangy crepe (dosa) made from a fermented batter of rice and lentils. It is wrapped around a savory, spiced filling of mashed potatoes, onions, mustard seeds, and curry leaves (the &quot;masala&quot;).</rdfs:comment>
        <rdfs:label>Masala Dosa</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/southasianstreetfood#hasSpiceLevel">
        <rdfs:label>hasSpiceLevel</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://example.org/southasianstreetfood#instructions">
        <rdfs:label>instructions</rdfs:label>
    </rdf:Description>



