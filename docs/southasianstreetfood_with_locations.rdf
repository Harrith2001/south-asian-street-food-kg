                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#water"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasPrepTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">80</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Prepare dough and let it rest until pliable
Divide into small balls and roll thin
Cut into circles and fold in half, then into a triangle
Create a pocket in the triangle and fill with potato-pea mixture
Seal edges by pressing and crimping using a bit of water
Deep fry in oil until golden brown and crispy
Serve hot with chutney or with tea</instructions>
        <rdfs:comment>Shingara is a popular Bengali street snack from Bangladesh, similar to samosa 
but with its own distinct flavor profile. It features a crispy, triangular pastry 
filled with a spiced potato and pea mixture with mustard seeds and turmeric. 
Typically enjoyed as a breakfast or evening snack with tea.</rdfs:comment>
        <rdfs:label>Shingara</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#SpiceLevel -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#SpiceLevel">
        <rdfs:label>Spice Level</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#Steaming -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#Steaming">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#CookingTechnique"/>
        <oboInOwl:hasDbXref>http://purl.obolibrary.org/obo/FOODON_03450023</oboInOwl:hasDbXref>
        <rdfs:comment>Cooked suspended above boiling water.</rdfs:comment>
        <rdfs:label>Steaming</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#StreetFood -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#StreetFood">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#Recipe"/>
        <rdfs:label>StreetFood</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#Tempering -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#Tempering">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#CookingTechnique"/>
        <oboInOwl:hasDbXref>https://www.wikidata.org/wiki/Q3222589</oboInOwl:hasDbXref>
        <rdfs:comment>Tempering spices (also known as tadka, chaunk, or vaggarane) is a fundamental culinary technique in South Asian cooking. It involves blooming whole or ground spices in hot oil or ghee to extract fat-soluble flavors and aromas.</rdfs:comment>
        <rdfs:label>Tempering</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#VadaPav -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#VadaPav">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasDietaryProperty"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Vegetarian"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9887"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasSpiceLevel"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Medium"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#originatesFrom"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#India"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#popularIn"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Bangladesh"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Assembling"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Cutting"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#PanFrying"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#GramFlour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#hawaiian%20bread%20dinner%20rolls"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasPrepTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">45</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Boil potatoes with chickpeas, mash, season with spices, and form into a round ball
Coat the ball lightly with gram flour batter
Deep fry until golden brown
Prepare bread: Spread mint-coriander chutney on the inside of a pav (hawaiian bread roll)
Place the hot vada inside the pav
Serve hot with additional chutney on the side</instructions>
        <rdfs:comment>Vada pav is a wildly popular, vegetarian street food from Mumbai, India, often referred to as the &quot;Indian burger&quot;. It consists of a spicy, deep-fried potato fritter (vada) sandwiched inside a soft, fluffy white bread roll (pav). The sandwich is typically slathered with vibrant, flavorful chutneys and served with a fried green chili.</rdfs:comment>
        <rdfs:label>VadaPav</rdfs:label>
    </owl:Class>
    


