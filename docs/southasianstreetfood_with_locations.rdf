        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#mint%20(fresh)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#tamarind%20paste"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasPrepTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">90</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>In bowl whisk together yogurt with tamarind paste, roasted cumin powder, black salt, crushed mint. 
Add fried dumplings to yogurt mixture. 
Sprinkle fresh coriander leaves. 
Serve chilled or at room temperature. 
Serve immediately after combining for best texture.</instructions>
        <rdfs:comment>Dahi Baray (also known as dahi bhalla or dahi vada) is a highly popular and refreshing street food snack in the Indian subcontinent. It consists of soft, deep-fried lentil dumplings (baray) soaked in a creamy yogurt sauce and topped with an array of sweet, spicy, and tangy chutneys.</rdfs:comment>
        <rdfs:label>Dahi Bharay</rdfs:label>
    </owl:Class>
    


