            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Soak moong dal 1 hour, grind to smooth paste. 
Mix with chopped green chili, minced ginger, cumin seeds, salt. 
Drop spoonfuls into hot oil, deep fry until golden. 
Drain on paper towels.</instructions>
        <rdfs:label>Bharay - Lentil Dumplings</rdfs:label>
    </owl:Class>
    


