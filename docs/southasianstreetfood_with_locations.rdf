            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Take mint and coriander leaves, add it in a blender.
Add garlic, ginger, salt, lemon juice in it.
Blend it with a bit of water inside.
Till it becomes a smooth paste.</instructions>
        <rdfs:label>mint - coriander chutney</rdfs:label>
    </owl:Class>
    


