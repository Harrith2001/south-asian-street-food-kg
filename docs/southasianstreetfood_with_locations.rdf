<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/southasianstreetfood#"
     xml:base="http://example.org/southasianstreetfood"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sasf="http://example.org/southasianstreetfood#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:RecipeOn="http://purl.org/ProductKG/RecipeOn#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:Ingredient="http://purl.org/ProductK/ingredientset-ingredient#"
     xmlns:SpecificationMetadata="https://www.omg.org/techprocess/ab/SpecificationMetadata/">
    <owl:Ontology rdf:about="http://example.org/southasianstreetfood">
        <owl:imports rdf:resource="http://purl.org/ProductKG/ingredientset-ingredient"/>
        <rdfs:comment>Ontology for South Asian Street foods from India, Pakistan, and Bangladesh. Includes 14 dishes with their ingredients, cooking methods, dietary properties, and regional origins. Ingredients are linked to FoodOn and Wikidata where available. Countries are linked to GeoNames.
The Top Level Ontology connected to it is IngredientSet-Ingredient from the ProductKG. (this needs to be imported before you check the entities)

Note:
All the ingredients for the dish have been taken from different sources and we have tried to be as precise as possible. Still the way to make street food can be different for everyone and it can have a lot of variations. We went with the most common ones.</rdfs:comment>
        <rdfs:label>South Asian Street Food Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/southasianstreetfood#instructions -->

    <owl:AnnotationProperty rdf:about="http://example.org/southasianstreetfood#instructions">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/ProductKG/RecipeOn#hasIngredient -->

    <owl:AnnotationProperty rdf:about="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/southasianstreetfood#hasDietaryProperty -->

    <owl:ObjectProperty rdf:about="http://example.org/southasianstreetfood#hasDietaryProperty">
        <rdfs:domain rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:range rdf:resource="http://example.org/southasianstreetfood#DietaryProperty"/>
        <rdfs:label>hasDietaryProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/southasianstreetfood#hasIngredientSet -->

    <owl:ObjectProperty rdf:about="http://example.org/southasianstreetfood#hasIngredientSet">
        <rdfs:domain rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:label>hasIngredientSet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/southasianstreetfood#hasQuantity -->

    <owl:ObjectProperty rdf:about="http://example.org/southasianstreetfood#hasQuantity">
        <rdfs:domain rdf:resource="http://purl.org/ProductKG/RecipeOn#Ingredient"/>
        <rdfs:range rdf:resource="http://purl.org/ProductKG/RecipeOn#Quantity"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/southasianstreetfood#hasSpiceLevel -->

    <owl:ObjectProperty rdf:about="http://example.org/southasianstreetfood#hasSpiceLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:range rdf:resource="http://example.org/southasianstreetfood#SpiceLevel"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/southasianstreetfood#isVariantOf -->

    <owl:ObjectProperty rdf:about="http://example.org/southasianstreetfood#isVariantOf">
        <rdfs:domain rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:range rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:label>isVariantOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/southasianstreetfood#originatesFrom -->

    <owl:ObjectProperty rdf:about="http://example.org/southasianstreetfood#originatesFrom">
        <rdfs:domain rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:range rdf:resource="http://example.org/southasianstreetfood#Country"/>
        <rdfs:label>originatesFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/southasianstreetfood#popularIn -->

    <owl:ObjectProperty rdf:about="http://example.org/southasianstreetfood#popularIn">
        <rdfs:domain rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:range rdf:resource="http://example.org/southasianstreetfood#Country"/>
        <rdfs:label>popularIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/southasianstreetfood#usesMethod -->

    <owl:ObjectProperty rdf:about="http://example.org/southasianstreetfood#usesMethod">
        <rdfs:domain rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:range rdf:resource="http://example.org/southasianstreetfood#CookingTechnique"/>
        <rdfs:label>usesMethod</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/ProductKG/RecipeOn#hasIngredient -->

    <rdf:Description rdf:about="http://purl.org/ProductKG/RecipeOn#hasIngredient">
        <rdfs:domain rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/southasianstreetfood#hasPrepTime -->

    <owl:DatatypeProperty rdf:about="http://example.org/southasianstreetfood#hasPrepTime">
        <rdfs:domain rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasPrepTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/southasianstreetfood#hasSpiceLevel -->

    <owl:DatatypeProperty rdf:about="http://example.org/southasianstreetfood#hasSpiceLevel">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/southasianstreetfood#instructions -->

    <owl:DatatypeProperty rdf:about="http://example.org/southasianstreetfood#instructions"/>
    


    <!-- http://example.org/southasianstreetfood#isVegetarian -->

    <owl:DatatypeProperty rdf:about="http://example.org/southasianstreetfood#isVegetarian">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>isVegetarian</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/southasianstreetfood#servingTemperature -->

    <owl:DatatypeProperty rdf:about="http://example.org/southasianstreetfood#servingTemperature">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>servingTemperature</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/southasianstreetfood#AlooTikki -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#AlooTikki">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasDietaryProperty"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Vegetarian"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9887"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasSpiceLevel"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Medium"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#originatesFrom"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#India"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#popularIn"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Pakistan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#PanFrying"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasPrepTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">45</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Boil potatoes until fork tender. 
Peel, cool completely, mash. 
Add finely chopped green chili, onion, ginger-garlic paste.
Mix in roasted cumin, garam masala, red chili powder, turmeric, salt. 
Add corn flour and breadcrumbs for binding. 
Mix in fresh coriander. Shape into patties. 
Chill 10 minutes. 
Heat oil in pan over medium heat. 
Fry patties 2-3 minutes each side until golden brown. 
Serve hot with mint and tamarind chutneys.</instructions>
        <rdfs:comment>Aloo Tikki (which translates to &quot;potato patty&quot; or &quot;potato croquette&quot;) is a popular vegetarian snack from the Indian subcontinent. It is made of boiled, mashed potatoes, peas, and various spices, shaped into small patties and pan-fried until golden and crispy.</rdfs:comment>
        <rdfs:label>Aloo Tikki</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#Asafoetida -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#Asafoetida">
        <rdfs:subClassOf rdf:resource="http://purl.org/ProductKG/RecipeOn#Ingredient"/>
        <rdfs:label>Asafoetida</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#Assembling -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#Assembling">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#CookingTechnique"/>
        <oboInOwl:hasDbXref>https://www.wikidata.org/wiki/Q3480053</oboInOwl:hasDbXref>
        <rdfs:comment>combining pre-prepared, semi-prepared, or raw ingredients into a finished dish without traditional cooking methods like heating or boiling</rdfs:comment>
        <rdfs:label>Assembling</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#Bangladesh -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#Bangladesh">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#Country"/>
        <oboInOwl:hasDbXref rdf:resource="http://www.geonames.org/1210997/"/>
        <rdfs:comment>Country in South Asia</rdfs:comment>
        <rdfs:label>Bangladesh</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#Beguni -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#Beguni">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Cutting"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#EggPlant"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasDietaryProperty"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Vegetarian"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9892"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasSpiceLevel"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#originatesFrom"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Bangladesh"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#popularIn"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#India"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#DeepFrying"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#mustard%20oil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasPrepTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">25</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Slice eggplant lengthwise into 2mm thick slices. 
Mix gram flour, rice flour, turmeric, red chili, cumin, salt and kalonji in bowl.
Whisking continuously, add water to make smooth, medium-flowing batter. 
Dip eggplant slices in batter, coating well. 
Deep fry in mustard oil at medium-high heat until crispy, golden brown on both sides. 
Drain on paper towels. 
Serve hot with mint-coriander chutney.</instructions>
        <rdfs:comment>Beguni is a popular Bengali snack made by dipping thin slices of eggplant (brinjal) into a spiced gram flour (besan) batter and deep-frying them until crispy and golden. It is a beloved street food and a comforting home-cooked treat native to West Bengal, India, and Bangladesh.</rdfs:comment>
        <rdfs:label>Beguni</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/southasianstreetfood#BhelPuri -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#BhelPuri">
