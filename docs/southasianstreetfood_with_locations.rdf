                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#chickpeas%20cooked"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#coriander%20leaf"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#cumin%20seeds%20(roasted)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#green%20chilies%20(chopped)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#lemon%20juice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#mustard%20oil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#onion%20finley%20(chopped)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#red%20chili%20powder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasPrepTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">35</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Boil chickpeas, eggs, potatoes separately until soft. Peel eggs, chop. Dice potatoes. In bowl combine boiled chickpeas, chopped egg, potato cubes. Add finely chopped onion, green chili. Mix tamarind chutney and green chutney. Pour over mixture. Sprinkle chaat masala, roasted cumin, red chili powder, salt. Drizzle mustard oil. Squeeze lemon juice. Mix gently. Garnish with fresh coriander. Serve warm or at room temperature in bowl.</instructions>
        <rdfs:comment>Chotpoti is a popular and savory Bengali street food that originated in Bangladesh and West Bengal, India. The name loosely translates to &quot;spicy&quot;. It is a tangy, hot, and flavorful dish consisting of boiled yellow peas and potatoes simmered in a spiced, tamarind-based broth.</rdfs:comment>
        <rdfs:label>Chotpoti</rdfs:label>
    </owl:Class>
    


