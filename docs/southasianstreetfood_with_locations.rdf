    <!-- http://example.org/southasianstreetfood#Samosa -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#Samosa">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#StreetFood"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasDietaryProperty"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Vegetarian"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9888"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9890"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasSpiceLevel"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Medium"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#isVariantOf"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Shingara"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#originatesFrom"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Pakistan"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#popularIn"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#India"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Assembling"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#DeepFrying"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#water"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasPrepTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">80</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Roll dough into thin circles
Cut in half to form a semi-circle
Fold each semi-circle into a cone shape
Seal edges with water
Fill the cone with spiced potato-pea mixture
Seal the open edge tightly
Deep fry until golden and crispy on all sides
Drain on paper towels and serve hot with chutney</instructions>
        <rdfs:comment>Samosa is a crispy, triangular pastry from Pakistan, traditionally served 
as a street snack or appetizer. It consists of a thin, flaky fried dough 
shell (paratha-like texture) stuffed with a savory filling of spiced potatoes 
and peas. Usually served with tamarind chutney or mint sauce.</rdfs:comment>
        <rdfs:label>Samosa</rdfs:label>
    </owl:Class>
    


