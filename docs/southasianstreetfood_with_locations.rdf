            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#mustard%20seeds"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#onion%20fine%20(chopped)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#turmeric%20(powdered)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Heat oil and add mustard seeds until they crackle. Add cumin seeds, then onions 
and green chili. Sauté until golden. Add mashed potatoes and peas with turmeric 
and salt. Cook for 3-4 minutes, stirring gently. The mustard seeds give shingara 
its distinctive Bengali flavor. Cool before filling.</instructions>
        <rdfs:label>Shingara Filling</rdfs:label>
    </owl:Class>
    


