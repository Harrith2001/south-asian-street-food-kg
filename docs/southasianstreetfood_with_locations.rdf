        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9891"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasIngredientSet"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#IngSet9894"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasSpiceLevel"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Medium"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#originatesFrom"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#India"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Assembling"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Mixing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasPrepTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">20</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Mix puffed rice with vegetables, sev and chutneys. Serve immediately on leaf or plate. Eat with tamarind chutney and green chutney.</instructions>
        <rdfs:comment>Bhelpuri is a wildly popular savory Indian snack and a type of chaat. It is celebrated for its addictive combination of textures, crispy, crunchy, and soft, and a flavor profile that is simultaneously sweet, spicy, tangy, and salty.</rdfs:comment>
        <rdfs:label>Bhel Puri</rdfs:label>
    </owl:Class>
    


