        <rdfs:label>GeographicArea</rdfs:label>
        <rdfs:comment>Abstract superclass for all geographic regions. Country and City are subclasses. Extensible to new countries and cities without changing the existing ontology.</rdfs:comment>
    </owl:Class>


    <!-- Extend existing Country class to be subclass of GeographicArea (non-destructive) -->

    <rdf:Description rdf:about="http://example.org/southasianstreetfood#Country">
        <rdfs:subClassOf rdf:resource="http://example.org/southasianstreetfood#GeographicArea"/>
    </rdf:Description>


