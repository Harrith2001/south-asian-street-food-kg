                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#ChickPea(Cooked)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#coriander%20leaf"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#green%20chilies%20(chopped)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#lemon%20juice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#onions%20fine%20(chopped)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#tomato%20(chopped)"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#hasPrepTime"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">30</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Boil chickpeas until soft, drain. In bowl add boiled chickpeas, finely chopped onion, tomato, green chili, coriander. Drizzle tamarind chutney and green chutney. Sprinkle chaat masala, roasted cumin, red chili powder, salt, black salt. Mix well. Add lemon juice. Serve immediately in bowl or leaf. Can be served hot or at room temperature.</instructions>
        <rdfs:comment>Chana Chaat is a popular, protein-packed South Asian street food and snack. It is essentially a zesty chickpea salad tossed with fresh, crunchy vegetables and a vibrant mix of sweet, tangy, and spicy flavors.</rdfs:comment>
        <rdfs:label>Chana Chaat</rdfs:label>
    </owl:Class>
    


