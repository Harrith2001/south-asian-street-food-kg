            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/southasianstreetfood#usesMethod"/>
                <owl:someValuesFrom rdf:resource="http://example.org/southasianstreetfood#Mixing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#oil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#salt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#water"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#all-purpose%20flour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/ProductKG/RecipeOn#hasIngredient"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/ProductKG/RecipeOn#turmeric%20powder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <instructions>Mix flour, salt, and turmeric powder. Add oil and rub until the mixture resembles 
coarse sand. Gradually add water while mixing to form a medium-soft dough. 
Knead gently for 5 minutes until smooth. Cover with a damp cloth and let rest 
for 20 minutes. The dough should be softer than samosa dough but not sticky.</instructions>
        <rdfs:label>Shingara Dough</rdfs:label>
    </owl:Class>
    


