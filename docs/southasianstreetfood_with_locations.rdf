    <!-- http://example.org/southasianstreetfood#IngSet9895 -->

    <owl:Class rdf:about="http://example.org/southasianstreetfood#IngSet9895">
        <rdfs:subClassOf rdf:resource="http://purl.org/ProductKG/RecipeOn#IngredientSet"/>
        <rdfs:subClassOf>
